{
  "entities": {
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Global system configuration including academic year, PVC tray calibration, and sample guardian photo URL.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner or admin.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "academicYear": {
          "type": "integer",
          "description": "Current Buddhist academic year (e.g. 2569)."
        },
        "trayConfig": {
          "type": "object",
          "description": "PVC card tray dimensions and slot X/Y coordinates in mm."
        },
        "designerSamplePhotoUrl": {
          "type": "string",
          "description": "Firebase Storage download URL or firestore-asset:// reference for the designer preview sample guardian photo.",
          "maxLength": 2048
        },
        "designerSamplePhotoPath": {
          "type": "string",
          "description": "Firebase Storage object path for the designer preview sample photo.",
          "maxLength": 512
        },
        "designerSamplePhotoAssetId": {
          "type": "string",
          "description": "Firestore image_assets document ID for the sample photo.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["ownerId", "academicYear", "trayConfig", "createdAt", "updatedAt"]
    },
    "FrontCardDesign": {
      "title": "FrontCardDesign",
      "description": "Front side pickup card template with typography, layout coordinates, and Firebase background image reference.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Template document ID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the creator.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Template display name.",
          "maxLength": 200
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this template is the default for its education level."
        },
        "level": {
          "type": "string",
          "description": "Target education level.",
          "enum": ["มัธยมศึกษาตอนต้น", "มัธยมศึกษาตอนปลาย"]
        },
        "title": {
          "type": "string",
          "description": "Card title text.",
          "maxLength": 200
        },
        "subtitle": {
          "type": "string",
          "description": "School or organization subtitle.",
          "maxLength": 200
        },
        "bgImageUrl": {
          "type": "string",
          "description": "Preset SVG, Firebase Storage download URL, or firestore-asset:// reference.",
          "maxLength": 10000
        },
        "bgImageStoragePath": {
          "type": "string",
          "description": "Firebase Storage path for uploaded background image.",
          "maxLength": 512
        },
        "bgImageAssetId": {
          "type": "string",
          "description": "Firestore image_assets document ID for uploaded background image.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "bgType": {
          "type": "string",
          "description": "Background image type.",
          "enum": ["preset", "custom"]
        },
        "bgLayerAbovePhoto": {
          "type": "boolean",
          "description": "Render PNG overlay above guardian photo."
        },
        "cardWidthMm": {
          "type": "number",
          "description": "Card width in millimeters (default 85.6mm for CR80)."
        },
        "cardHeightMm": {
          "type": "number",
          "description": "Card length/height in millimeters (default 54.0mm for CR80)."
        },
        "elements": {
          "type": "object",
          "description": "Element positions and styles on the front card."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["id", "ownerId", "level", "title", "subtitle", "bgImageUrl", "bgType", "elements", "createdAt", "updatedAt"]
    },
    "BackCardDesign": {
      "title": "BackCardDesign",
      "description": "Back side pickup card template with rules, emergency contact, colors, and Firebase background reference.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Template document ID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the creator.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Template display name.",
          "maxLength": 200
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this template is the default back card design."
        },
        "displayMode": {
          "type": "string",
          "description": "Template layout mode.",
          "enum": ["template", "imageOnly"]
        },
        "title": {
          "type": "string",
          "description": "Back card header title.",
          "maxLength": 200
        },
        "subtitle": {
          "type": "string",
          "description": "School or organization subtitle.",
          "maxLength": 200
        },
        "rules": {
          "type": "array",
          "description": "List of usage rules printed on the back of the card."
        },
        "emergencyLabel": {
          "type": "string",
          "description": "Emergency contact label.",
          "maxLength": 200
        },
        "emergencyPhone": {
          "type": "string",
          "description": "Emergency phone numbers.",
          "maxLength": 100
        },
        "footerNote": {
          "type": "string",
          "description": "Footer note text.",
          "maxLength": 300
        },
        "accentColor": {
          "type": "string",
          "description": "Hex accent color.",
          "maxLength": 30
        },
        "textColor": {
          "type": "string",
          "description": "Hex text color.",
          "maxLength": 30
        },
        "bgColor": {
          "type": "string",
          "description": "Hex background color.",
          "maxLength": 30
        },
        "bgImageUrl": {
          "type": "string",
          "description": "Firebase Storage download URL or firestore-asset:// reference for back card image.",
          "maxLength": 2048
        },
        "bgImageStoragePath": {
          "type": "string",
          "description": "Firebase Storage object path for back card image.",
          "maxLength": 512
        },
        "bgImageAssetId": {
          "type": "string",
          "description": "Firestore image_assets document ID for back card image.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "showLogo": {
          "type": "boolean",
          "description": "Whether to show the school logo."
        },
        "showSignatureBox": {
          "type": "boolean",
          "description": "Whether to show the signature box."
        },
        "signatureLabel": {
          "type": "string",
          "description": "Label under the signature line.",
          "maxLength": 150
        },
        "cardWidthMm": {
          "type": "number",
          "description": "Back card width in millimeters (default 85.6mm for CR80)."
        },
        "cardHeightMm": {
          "type": "number",
          "description": "Back card length/height in millimeters (default 54.0mm for CR80)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["id", "ownerId", "displayMode", "title", "subtitle", "rules", "accentColor", "textColor", "bgColor", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record keyed by 5-digit studentId.",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "description": "5-digit primary key.",
          "maxLength": 12,
          "pattern": "^[0-9]{5}$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the creator.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "prefix": {
          "type": "string",
          "maxLength": 50
        },
        "firstName": {
          "type": "string",
          "maxLength": 120
        },
        "lastName": {
          "type": "string",
          "maxLength": 120
        },
        "nickname": {
          "type": "string",
          "maxLength": 80
        },
        "level": {
          "type": "string",
          "enum": ["มัธยมศึกษาตอนต้น", "มัธยมศึกษาตอนปลาย"]
        },
        "classroom": {
          "type": "string",
          "maxLength": 30
        },
        "entryYear": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["studentId", "ownerId", "prefix", "firstName", "lastName", "level", "classroom", "entryYear", "createdAt", "updatedAt"]
    },
    "Guardian": {
      "title": "Guardian",
      "description": "Guardian profile with Firebase Storage URL or firestore-asset:// reference.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "prefix": {
          "type": "string",
          "maxLength": 50
        },
        "firstName": {
          "type": "string",
          "maxLength": 120
        },
        "lastName": {
          "type": "string",
          "maxLength": 120
        },
        "relation": {
          "type": "string",
          "maxLength": 80
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "photoFileName": {
          "type": "string",
          "maxLength": 256
        },
        "photoStoragePath": {
          "type": "string",
          "maxLength": 512
        },
        "photoAssetId": {
          "type": "string",
          "description": "Firestore image_assets document ID for guardian photo.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "prefix", "firstName", "lastName", "relation", "photoUrl", "photoFileName", "createdAt", "updatedAt"]
    },
    "PickupCard": {
      "title": "PickupCard",
      "description": "Issued student pickup card linking a student and guardian.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "maxLength": 12,
          "pattern": "^[0-9]{5}$"
        },
        "guardianId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "issueDate": {
          "type": "string",
          "maxLength": 20
        },
        "expiryDate": {
          "type": "string",
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "enum": ["active", "expired", "revoked"]
        },
        "qrCodeText": {
          "type": "string",
          "maxLength": 300
        },
        "frontDesignId": {
          "type": "string",
          "description": "Optional preferred front card design template ID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "printCount": {
          "type": "integer"
        },
        "lastPrintedAt": {
          "type": "string",
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "studentId", "guardianId", "issueDate", "expiryDate", "status", "qrCodeText", "printCount", "createdAt", "updatedAt"]
    },
    "PrintHistoryItem": {
      "title": "PrintHistoryItem",
      "description": "Immutable log entry for PVC card prints.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "timestamp": {
          "type": "string",
          "maxLength": 60
        },
        "thaiDateString": {
          "type": "string",
          "maxLength": 100
        },
        "studentId": {
          "type": "string",
          "maxLength": 20
        },
        "studentName": {
          "type": "string",
          "maxLength": 200
        },
        "guardianName": {
          "type": "string",
          "maxLength": 200
        },
        "level": {
          "type": "string",
          "enum": ["มัธยมศึกษาตอนต้น", "มัธยมศึกษาตอนปลาย"]
        },
        "classroom": {
          "type": "string",
          "maxLength": 40
        },
        "slotNumber": {
          "type": "integer"
        },
        "printType": {
          "type": "string",
          "enum": ["บัตรใหม่", "พิมพ์ซ้ำ (Reprint)"]
        },
        "printSide": {
          "type": "string",
          "enum": ["หน้าบัตร", "หลังบัตร"]
        },
        "operatorName": {
          "type": "string",
          "maxLength": 150
        },
        "cardId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "timestamp", "thaiDateString", "studentId", "studentName", "guardianName", "level", "classroom", "slotNumber", "printType", "operatorName", "cardId", "createdAt"]
    },
    "OperatorAccount": {
      "title": "OperatorAccount",
      "description": "Authorized operator profile mapped to a Firebase Auth UID and username for User/Password login (never stores passwords).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID matching Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the creator/admin.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the operator.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Short login username (e.g. admin, staff01).",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_.\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "Resolved Firebase Auth email address.",
          "maxLength": 200
        },
        "fullName": {
          "type": "string",
          "description": "Display full name.",
          "maxLength": 150
        },
        "position": {
          "type": "string",
          "description": "Staff position title.",
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "uid", "username", "email", "fullName", "position", "role", "isActive", "createdAt", "updatedAt"]
    },
    "ImageAsset": {
      "title": "ImageAsset",
      "description": "Compressed image library asset stored directly in Firestore (with optional Firebase Storage URL) for reliable cross-device loading and reuse.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Image asset document ID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the uploader.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "description": "Asset usage category.",
          "enum": ["front_bg", "back_bg", "guardian_photo", "sample_photo", "qr_code", "school_logo"]
        },
        "fileName": {
          "type": "string",
          "description": "Normalized image file name.",
          "maxLength": 256
        },
        "contentType": {
          "type": "string",
          "description": "Image MIME type.",
          "enum": ["image/webp", "image/jpeg", "image/png", "image/svg+xml"]
        },
        "width": {
          "type": "integer",
          "description": "Image pixel width."
        },
        "height": {
          "type": "integer",
          "description": "Image pixel height."
        },
        "originalSize": {
          "type": "integer",
          "description": "Original file byte size."
        },
        "compressedSize": {
          "type": "integer",
          "description": "Compressed file byte size."
        },
        "storageBackend": {
          "type": "string",
          "description": "Where the binary/dataUrl is stored.",
          "enum": ["both", "storage", "firestore"]
        },
        "storageUrl": {
          "type": "string",
          "description": "Optional Firebase Storage download URL.",
          "maxLength": 2048
        },
        "storagePath": {
          "type": "string",
          "description": "Optional Firebase Storage object path.",
          "maxLength": 512
        },
        "dataUrl": {
          "type": "string",
          "description": "Compressed image Data URL bounded safely below Firestore 1MB doc limit.",
          "maxLength": 800000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["id", "ownerId", "category", "fileName", "contentType", "width", "height", "originalSize", "compressedSize", "storageBackend", "createdAt", "updatedAt"]
    },
    "PrintHeaderPreset": {
      "title": "PrintHeaderPreset",
      "description": "Saved custom A4 print header presets for guardian card registry reports.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Print header preset document ID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the creator.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Main custom header text.",
          "maxLength": 300
        },
        "subtitle": {
          "type": "string",
          "description": "Optional subtitle or organization line.",
          "maxLength": 300
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this header preset is selected by default before printing."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["id", "ownerId", "title", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/system_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "System-wide configuration (academic year, tray calibration, sample photo reference)."
    },
    "/front_designs/{designId}": {
      "schema": { "$ref": "#/entities/FrontCardDesign" },
      "description": "Front card design templates and layout coordinates."
    },
    "/back_designs/{designId}": {
      "schema": { "$ref": "#/entities/BackCardDesign" },
      "description": "Back card design templates and styling."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student directory keyed by 5-digit studentId."
    },
    "/guardians/{guardianId}": {
      "schema": { "$ref": "#/entities/Guardian" },
      "description": "Authorized guardian profiles with compressed Firebase Storage / Firestore image references."
    },
    "/cards/{cardId}": {
      "schema": { "$ref": "#/entities/PickupCard" },
      "description": "Issued student pickup cards linking students and guardians."
    },
    "/print_history/{historyId}": {
      "schema": { "$ref": "#/entities/PrintHistoryItem" },
      "description": "Audit trail of printed cards."
    },
    "/operator_accounts/{accountId}": {
      "schema": { "$ref": "#/entities/OperatorAccount" },
      "description": "Authorized operator accounts for User & Password login (passwords handled exclusively by Firebase Auth)."
    },
    "/image_assets/{assetId}": {
      "schema": { "$ref": "#/entities/ImageAsset" },
      "description": "Compressed card background, guardian portrait, and sample images persisted in Firestore for unified Firebase storage and instant reuse."
    },
    "/print_headers/{headerId}": {
      "schema": { "$ref": "#/entities/PrintHeaderPreset" },
      "description": "Saved custom A4 report header presets for guardian pickup card registry printing."
    }
  }
}
